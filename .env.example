# =================================================================
# VoicePilot Environment Configuration (.env.example)
# Do NOT commit actual secrets or API keys to version control.
# =================================================================

# Application Mode
APP_NAME=VoicePilot
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Demo & Safety Controls
# When DEMO_MODE=true, authenticated POST /api/demo/reset is active
DEMO_MODE=true
DEMO_API_KEY=voicepilot-demo-key

# Provider Selection: groq (cloud fast-path) | local (faster-whisper) | mock (CI/offline)
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

# Cloud Provider API Keys (Leave blank for mock or local offline mode)
GROQ_API_KEY=
OPENAI_API_KEY=

# Audio Validation Thresholds
MAX_AUDIO_SECONDS=30.0
MIN_SPEECH_DURATION_SECONDS=0.5
MIN_SNR_DB=10.0
MAX_SILENCE_RATIO=0.85
MAX_CLIPPING_RATIO=0.05

# Timeouts & Retries
PROVIDER_TIMEOUT_SECONDS=8.0
STT_MAX_RETRIES=1

# Local Whisper Engine (Used when STT_PROVIDER=local or fallback)
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Edge Neural TTS Voice (Used when TTS_PROVIDER=edge)
EDGE_TTS_VOICE=en-US-JennyNeural

# Session Memory Window
MAX_SESSION_TURNS=3

# Logging & Privacy Redaction
LOG_LEVEL=INFO
REDACT_LOGS=true
